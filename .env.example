DATABASE_URL=postgresql://app:app@localhost:5432/app

MINIO_ENDPOINT=localhost.floci.io:4566
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_SOURCE_BUCKET=features
MINIO_SECURE=false

MODEL_DIR=.cache/models/building-segmentation-poland-b3/best_model
MODEL_DEVICE=auto

RESULTS_DIR=results/database-worker
JOB_POLL_SECONDS=3

MODEL_THRESHOLD=0.8
MODEL_TILE_SIZE=512
MODEL_OVERLAP=64
MODEL_BATCH_SIZE=4

MODEL_MIN_AREA_M2=4.0
MODEL_HOLE_AREA_M2=1.0

MODEL_SIMPLIFY_M=0.50
MODEL_ORTHOGONALIZE=false
MODEL_ORTHOGONAL_ANGLE_DEG=10.0

GEOMETRY_MODE=rectangles

MODEL_RECTANGLE_SNAP_DISTANCE=0.5
MODEL_RECTANGLE_SNAP_ANGLE_DEG=8.0
MODEL_RECTANGLE_GAP_CLOSE_DISTANCE=0.5
MODEL_MAX_RECTANGLE_WASTE=0.18
MODEL_MAX_RECTANGLE_PARTS=8
MODEL_MIN_RECTANGLE_AREA_M2=2.0

MODEL_SAVE_PROBABILITY=false
MODEL_SAVE_MASK=false
